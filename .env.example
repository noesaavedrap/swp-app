# Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# MongoDB server-side analytics for the dashboards
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=swp_finance

# Auth0 server configuration
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_SECRET=generate-a-long-random-secret
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Optional: DNI / RUC lookup (json.pe or compatible)
# Without this token, validation only checks format and the user fills names manually.
JSONPE_API_TOKEN=
JSONPE_API_BASE_URL=https://api.json.pe
